<% content_for :title, "Your place in line" %>

<div class="flex flex-col gap-4">
  <% if notice.present? %>
    <div role="status" class="alert alert-info alert-soft text-sm">
      <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <div class="flex items-center justify-between gap-2">
    <h1 class="text-xl font-bold">Hi <%= @party.name.split.first %>, you're in line</h1>
    <span class="badge badge-neutral badge-soft gap-1 shrink-0">
      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Party of <%= @party.size %>
    </span>
  </div>

  <section class="card bg-base-100 shadow-sm">
    <div class="card-body items-center text-center gap-3 p-6">
      <p class="text-sm font-medium text-base-content/60">Your place in line</p>
      <p class="text-7xl font-black leading-none"><%= @party.position %><span class="text-3xl align-top"><%= @party.position.ordinal %></span></p>
      <p class="text-base-content/70">
        <%= @party.parties_ahead.zero? ? "You're next" : "#{pluralize(@party.parties_ahead, "party", plural: "parties")} ahead of you" %>
      </p>
    </div>
  </section>

  <div role="status" class="alert alert-info alert-soft text-sm">
    <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
    <span>We'll email you when it's your turn. Feel free to close this page.</span>
  </div>

  <p class="text-center text-xs text-base-content/60">
    Updated just now · <%= link_to "Refresh", party_path(@party), class: "link" %>
  </p>
</div>
