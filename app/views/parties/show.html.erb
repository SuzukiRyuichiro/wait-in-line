<% content_for :title, if @party.completed? then "Thanks for dining"
                     elsif @party.seated? then "Enjoy your meal"
                     elsif @party.ready? then "Your table is ready"
                     else "Your place in line" end %>

<div class="flex flex-col gap-4">
  <% if notice.present? %>
    <div role="status" class="alert alert-info alert-soft text-sm">
      <i data-lucide="info" class="size-5 shrink-0" aria-hidden="true"></i>
      <span><%= notice %></span>
    </div>
  <% end %>

  <% if @party.completed? %>
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body items-center text-center gap-3 p-6">
        <i data-lucide="heart" class="size-8 text-primary" aria-hidden="true"></i>
        <h1 class="text-2xl font-bold">Thanks for dining, <%= @party.name.split.first %>!</h1>
        <p class="text-base-content/70">We hope to see you again soon.</p>
        <%= link_to "Back to home", root_path, class: "btn btn-outline w-full" %>
      </div>
    </section>
  <% elsif @party.seated? %>
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body items-center text-center gap-2 p-6">
        <i data-lucide="utensils" class="size-8 text-primary" aria-hidden="true"></i>
        <h1 class="text-2xl font-bold">Enjoy your meal, <%= @party.name.split.first %>!</h1>
        <p>Party of <%= @party.size %>. Your service ends
          <time datetime="<%= @party.service_ends_at.iso8601(3) %>" data-island="countdown"
                data-server-now="<%= Time.current.iso8601(3) %>" class="font-semibold">in <%= pluralize([ (@party.service_ends_at - Time.current).ceil, 0 ].max, "second") %></time>.</p>
      </div>
    </section>
  <% elsif @party.ready? %>
    <section class="card bg-success/10 border border-success/30">
      <div class="card-body items-center text-center gap-3 p-6">
        <h1 class="text-2xl font-bold">Your table is ready, <%= @party.name.split.first %>!</h1>
        <p>Party of <%= @party.size %>. Your seats are being held for you.</p>
        <%= button_to party_check_in_path(@party), class: "btn btn-primary btn-lg w-full", form_class: "w-full" do %>
          <i data-lucide="log-in" class="size-5" aria-hidden="true"></i> Check in
        <% end %>
      </div>
    </section>
  <% else %>
    <div class="flex items-center justify-between gap-2">
      <h1 class="text-xl font-bold">Hi <%= @party.name.split.first %>, you're in line</h1>
      <span class="badge badge-neutral badge-soft gap-1 shrink-0">
        <i data-lucide="users" class="size-3.5" aria-hidden="true"></i>
        Party of <%= @party.size %>
      </span>
    </div>

    <section class="card bg-base-100 shadow-sm">
      <div class="card-body items-center text-center gap-3 p-6">
        <p class="text-sm font-medium text-base-content/60">Your place in line</p>
        <p class="text-7xl font-black leading-none"><%= @party.position %><span class="text-3xl align-top"><%= @party.position.ordinal %></span></p>
        <p class="text-base-content/70">
          <%= @party.parties_ahead.zero? ? "You're next" : "#{pluralize(@party.parties_ahead, "party", plural: "parties")} ahead of you" %>
        </p>
      </div>
    </section>

    <div role="status" class="alert alert-info alert-soft text-sm">
      <i data-lucide="mail" class="size-5 shrink-0" aria-hidden="true"></i>
      <span>We'll email you when it's your turn. Feel free to close this page.</span>
    </div>
  <% end %>

  <% unless @party.completed? %>
    <%# Waiting and seated pages change on their own, so they poll. A ready page
        only changes when the diner taps Check in. %>
    <% live = @party.waiting? || @party.seated? %>
    <%= tag.p class: "text-center text-xs text-base-content/60",
              data: (live ? { island: "live-status", status_url: party_status_path(@party, format: :json),
                              **@party.live_state } : {}) do %>
      Updated just now · <%= link_to "Refresh", party_path(@party), class: "link" %>
      <span data-reconnecting hidden aria-live="polite" class="text-warning">· Reconnecting…</span>
    <% end %>
  <% end %>
</div>
