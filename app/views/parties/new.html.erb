<% content_for :title, "Join the waitlist" %>

<div class="flex flex-col gap-5">
  <div class="flex flex-col gap-2 items-start">
    <span class="badge badge-warning badge-soft gap-1">
      <i data-lucide="clock" class="size-3.5" aria-hidden="true"></i>
      Fully booked right now
    </span>
    <h1 class="text-3xl font-bold">Join the waitlist</h1>
  </div>

  <% if @party.errors.any? %>
    <div role="alert" class="alert alert-error alert-soft text-sm">
      <i data-lucide="triangle-alert" class="size-5 shrink-0" aria-hidden="true"></i>
      <span>Please fix <%= pluralize(@party.errors.attribute_names.size, "field") %> below.</span>
    </div>
  <% else %>
    <div class="stats bg-base-100 shadow-sm w-full">
      <div class="stat px-4 py-3">
        <div class="stat-figure text-base-content/40">
          <i data-lucide="users" class="size-6" aria-hidden="true"></i>
        </div>
        <div class="stat-title">In line</div>
        <div class="stat-value text-2xl"><%= pluralize(@waiting_count, "party") %></div>
      </div>
    </div>
  <% end %>

  <%= form_with model: @party, url: parties_path, class: "card bg-base-100 shadow-sm" do |f| %>
    <div class="card-body gap-1 p-5">
      <fieldset class="fieldset p-0">
        <%= f.label :name, class: "fieldset-legend" %>
        <label class="input w-full <%= "input-error" if @party.errors[:name].any? %>">
          <i data-lucide="user" class="size-4 opacity-50" aria-hidden="true"></i>
          <%= f.text_field :name, class: "grow", placeholder: "Aiko Tanaka", autocomplete: "name", required: true, maxlength: 100,
                "aria-invalid": @party.errors[:name].any?.presence, "aria-describedby": ("name-err" if @party.errors[:name].any?) %>
        </label>
        <% if @party.errors[:name].any? %>
          <p id="name-err" class="label text-error whitespace-normal"><%= @party.errors.full_messages_for(:name).first %></p>
        <% end %>
      </fieldset>

      <fieldset class="fieldset p-0">
        <%= f.label :email, class: "fieldset-legend" %>
        <label class="input w-full <%= "input-error" if @party.errors[:email].any? %>">
          <i data-lucide="mail" class="size-4 opacity-50" aria-hidden="true"></i>
          <%= f.email_field :email, class: "grow", placeholder: "you@example.com", autocomplete: "email", required: true,
                "aria-invalid": @party.errors[:email].any?.presence, "aria-describedby": ("email-err" if @party.errors[:email].any?) %>
        </label>
        <% if @party.errors[:email].any? %>
          <p id="email-err" class="label text-error whitespace-normal"><%= @party.errors.full_messages_for(:email).first %></p>
        <% else %>
          <p class="label whitespace-normal">We'll only use it to tell you your table is ready.</p>
        <% end %>
      </fieldset>

      <fieldset class="fieldset p-0">
        <%= f.label :size, "Party size", class: "fieldset-legend" %>
        <div class="join w-full">
          <button type="button" class="btn join-item btn-square" aria-label="Fewer guests"
                  onclick="this.parentElement.querySelector('input').stepDown()">
            <i data-lucide="minus" class="size-4" aria-hidden="true"></i>
          </button>
          <%= f.number_field :size, value: @party.size || 2, min: Party::SIZE_RANGE.min, max: Party::SIZE_RANGE.max, required: true,
                class: "input join-item flex-1 text-center font-semibold #{"input-error" if @party.errors[:size].any?}",
                "aria-invalid": @party.errors[:size].any?.presence, "aria-describedby": ("size-err" if @party.errors[:size].any?) %>
          <button type="button" class="btn join-item btn-square" aria-label="More guests"
                  onclick="this.parentElement.querySelector('input').stepUp()">
            <i data-lucide="plus" class="size-4" aria-hidden="true"></i>
          </button>
        </div>
        <% if @party.errors[:size].any? %>
          <p id="size-err" class="label text-error whitespace-normal"><%= @party.errors.full_messages_for(:size).first %></p>
        <% else %>
          <p class="label"><%= Party::SIZE_RANGE.min %>–<%= Party::SIZE_RANGE.max %> guests</p>
        <% end %>
      </fieldset>

      <%= f.button type: "submit", class: "btn btn-primary btn-lg btn-block mt-3" do %>
        Join waitlist
        <i data-lucide="arrow-right" class="size-5" aria-hidden="true"></i>
      <% end %>
    </div>
  <% end %>
</div>
